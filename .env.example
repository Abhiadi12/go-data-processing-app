# Copy to .env and adjust. Every value shown is the default.

# HTTP port the API listens on
PORT=9090
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Directory that job source paths are resolved in. Paths cannot escape it.
DATA_DIR=.
# Maximum request body size in bytes (1 MiB)
MAX_BODY_BYTES=1048576

# HTTP server timeouts (Go duration format)
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Allow HTTP sources on loopback/private networks (local development only)
ALLOW_PRIVATE_SOURCES=false
# Maximum response size read from an HTTP source in bytes (50 MiB)
HTTP_SOURCE_MAX_BYTES=52428800
