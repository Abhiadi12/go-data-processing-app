# Copy to .env and adjust. Every value shown is the default.

# HTTP port the API listens on
PORT=9090
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Directory that job source paths are resolved in. Paths cannot escape it.
DATA_DIR=.
# Maximum request body size in bytes (1 MiB)
MAX_BODY_BYTES=1048576

# HTTP server timeouts (Go duration format)
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Allow HTTP sources on loopback/private networks (local development only)
ALLOW_PRIVATE_SOURCES=false
# Maximum response size read from an HTTP source in bytes (50 MiB)
HTTP_SOURCE_MAX_BYTES=52428800

# Jobs that run at the same time (1-64)
JOB_WORKERS=2
# Jobs that can wait for a free worker before POST returns 503 (1-10000)
JOB_QUEUE_SIZE=100
# How long a finished job stays in memory (checked every minute). Its output
# files and SQLite rows are kept; DELETE /api/v1/pipelines/{id} removes those.
JOB_TTL=24h

# Where job output files are written (data/output/<job-id>/...); created if missing
OUTPUT_DIR=data/output
# SQLite database file for exports of type "sqlite"; created and migrated at startup
SQLITE_PATH=data/datapipe.db

# When set (16+ characters), every /api/ request needs the header X-API-Key: <value>.
# /healthz, /docs and /openapi.json stay public. Empty = no key required.
API_KEY=
# Browser origins allowed to call the API, comma-separated, e.g.
# http://localhost:3000,https://app.example.com  ("*" = any). Empty = CORS off.
CORS_ALLOWED_ORIGINS=

# /api/ requests per second allowed per client IP (0-10000, 0 = no limit)
RATE_LIMIT_PER_SECOND=10
# Requests a client may send at once before the per-second limit applies (1-10000)
RATE_LIMIT_BURST=20
